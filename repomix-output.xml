/* ── BANNERS ── */
.errorBanner {
  background: #fdf2f2;
  border: 1px solid #f5c6c6;
  border-radius: 0.6rem;
  padding: 0.75rem 1rem;
  font-size: 0.82rem;
  color: #c0392b;
  margin-bottom: 1rem;
}

.successBanner {
  background: #f0faf4;
  border: 1px solid #a8d5b5;
