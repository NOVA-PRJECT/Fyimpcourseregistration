.campusCell {
  font-size: 0.75rem;
  color: #44474e;
}

.codeBadge {
  font-size: 0.68rem;
  font-weight: 700;
  font-family: monospace;
  padding: 0.2rem 0.55rem;
  border-radius: 0.35rem;
  background: #eef2ff;
  color: #3730a3;
  border: 1px solid #c7d2fe;
  letter-spacing: 0.05em;
}

/* ── ACTION BUTTONS ── */
.actionBtns {
  display: flex;
  gap: 0.4rem;
}

.editBtn {
  padding: 0.3rem 0.5rem;
  font-size: 0.8rem;
  background: #f0f4f8;
  border: 1px solid #dde1e7;
  border-radius: 0.35rem;
  cursor: pointer;
  transition: background 0.1s ease;
  line-height: 1;
}

.editBtn:hover {
  background: #e2e8f0;
}

.deleteBtn {
  padding: 0.3rem 0.5rem;
  font-size: 0.8rem;
  background: #fdf2f2;
  border: 1px solid #f5c6c6;
  border-radius: 0.35rem;
  cursor: pointer;
  transition: background 0.1s ease;
  line-height: 1;
}

.deleteBtn:hover {
  background: #fee2e2;
}

/* ── EMPTY STATE ── */
.emptyState {
  padding: 2.5rem 1rem;
  text-align: center;
}

.emptyIcon {
  font-size: 2rem;
  margin-bottom: 0.5rem;
}

.emptyTitle {
  font-size: 0.9rem;
  font-weight: 700;
