  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 1.25rem;
  position: relative;
  overflow: hidden;
}



/* Card */
.card {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 22rem;
  background: #ffffff;
  border-radius: 1rem;
