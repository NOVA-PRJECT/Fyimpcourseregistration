  margin: 0 0 0.25rem 0;
}

.emptySubtitle {
  font-size: 0.78rem;
  color: #9ba1ab;
  margin: 0;
}

/* ── LOADING ── */
.loadingState {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 3rem 1rem;
  gap: 1rem;
  min-height: 100dvh;
}

.spinner {
  width: 2rem;
  height: 2rem;
  border: 3px solid #e2e5ea;
  border-top-color: #002147;
